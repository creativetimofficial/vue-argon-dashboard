# ===================================
# VUE APP CONFIGURATION
# ===================================

# API Base URL (Backend Laravel API)
# PENTING: Vite memerlukan prefix VITE_ (bukan VUE_APP_)
VUE_APP_API_URL=http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Application Name

# Application Name
VUE_APP_NAME=Paynet

# Application Environment
VUE_APP_ENV=development

# ===================================
# PAYMENT GATEWAY PUBLIC KEYS
# ===================================

# Midtrans Client Key (Public)
VUE_APP_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key

# Midtrans Environment (sandbox/production)
VUE_APP_MIDTRANS_ENV=sandbox

# Xendit Public Key
VUE_APP_XENDIT_PUBLIC_KEY=your_xendit_public_key

# ===================================
# GOOGLE MAPS (Optional for technician location)
# ===================================
VUE_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===================================
# FEATURE FLAGS
# ===================================

# Enable/Disable features
VUE_APP_ENABLE_CHAT=false
VUE_APP_ENABLE_NOTIFICATIONS=true
VUE_APP_ENABLE_DARK_MODE=true

# ===================================
# OTHER SETTINGS
# ===================================

# Default currency
VUE_APP_CURRENCY=IDR
VUE_APP_CURRENCY_SYMBOL=Rp

# Date format
VUE_APP_DATE_FORMAT=DD/MM/YYYY
VUE_APP_DATETIME_FORMAT=DD/MM/YYYY HH:mm

# Pagination
VUE_APP_PAGE_SIZE=10

# File upload max size (in MB)
VUE_APP_MAX_FILE_SIZE=10


# reCAPTCHA Site Key (untuk frontend)
# Test Key (Development Only - GANTI dengan key Anda untuk production!)
VITE_RECAPTCHA_SITE_KEY=6LfzWV0sAAAAAMfWNl727klV4GUZ5WHbXuN8JlKl

# Production Key (Uncomment dan ganti dengan key Anda)
# VITE_RECAPTCHA_SITE_KEY=6LfzWV0sAAAAAMfWNl727klV4GUZ5WHbXuN8JlKl
